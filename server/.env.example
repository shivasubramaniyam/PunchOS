# Environment variables for the PunchOS Express backend.
# Copy to .env for local dev; set these in your Railway project for production.

# PostgreSQL connection string.
# Local: docker run -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:16
# Railway: add the Postgres plugin and reference it as ${{Postgres.DATABASE_URL}}.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/qr_attendance?schema=public"

# Server port (Railway injects this automatically).
PORT=8000

# WebAuthn Relying Party ID — MUST equal the exact domain the PWA is served from
# (no scheme, no port). Example: punch-pwa.vercel.app
# Leave unset for local dev: it then derives from the request Host header.
RP_ID=

# Optional CORS origin allowlist. Defaults to "*" (open) if unset.
CORS_ORIGIN=
